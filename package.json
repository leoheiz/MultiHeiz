{
  "name": "multiheiz",
  "productName": "MultiHeiz",
  "version": "1.3.0",
  "description": "Navegador multi-janela com painéis e sessões independentes",
  "homepage": "https://github.com/leoheiz/MultiHeiz",
  "repository": "github:leoheiz/MultiHeiz",
  "desktopName": "multiheiz.desktop",
  "main": "src/main/main.js",
  "author": {
    "name": "Leo (leoheiz)",
    "email": "leoheiz@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "selftest": "node tools/selftest.js",
    "selftest:mem": "node tools/selftest-mem.js",
    "selftest:ui": "node tools/selftest-ui.js",
    "selftest:bg": "node tools/selftest-bg.js",
    "selftest:v14": "node tools/selftest-v14.js",
    "selftest:input": "node tools/selftest-input.js",
    "selftest:v16": "node tools/selftest-v16.js",
    "selftest:adblock": "node tools/selftest-adblock.js",
    "selftest:adblock-startup": "node tools/selftest-adblock-startup.js",
    "selftest:fps": "node tools/selftest-fps.js",
    "selftest:packaged": "node tools/selftest-packaged.js",
    "selftest:v18": "node tools/selftest-v18.js",
    "selftest:v19": "node tools/selftest-v19.js",
    "selftest:titlebar": "node tools/selftest-titlebar.js",
    "selftest:fullscreen": "node tools/selftest-fullscreen.js",
    "selftest:ext": "node tools/selftest-ext.js",
    "selftest:store": "node tools/selftest-store.js",
    "selftest:updater": "node tools/selftest-updater.js",
    "selftest:diff-update": "node tools/selftest-diff-update.js",
    "selftest:diagnostics": "node tools/selftest-diagnostics.js",
    "selftest:v110": "node tools/selftest-v110.js",
    "selftest:v120": "node tools/selftest-v120.js",
    "selftest:security": "node tools/selftest-security.js",
    "selftest:sidebar": "node tools/selftest-sidebar.js",
    "check:realclick-sidebar": "node tools/realclick-sidebar.js",
    "check:realclick-sidebar2": "node tools/realclick-sidebar2.js",
    "check:realclick-legacy-compact": "node tools/realclick-legacy-compact.js",
    "check:realdrag-topbar": "node tools/realdrag-topbar.js",
    "check:realhover-fullscreen": "node tools/realhover-fullscreen.js",
    "shots:sidebar2": "node tools/shots-sidebar2.js",
    "selftest:workspace-delete": "node tools/selftest-workspace-delete.js",
    "selftest:shared-session": "node tools/selftest-shared-session.js",
    "selftest:ua": "node tools/selftest-ua.js",
    "selftest:gis": "node tools/selftest-gis.js",
    "selftest:abu-yt": "node tools/selftest-abu-yt.js",
    "selftest:builtin-yt": "node tools/selftest-builtin-yt.js",
    "selftest:contextmenu": "node tools/selftest-contextmenu.js",
    "selftest:proxy": "node tools/selftest-proxy.js",
    "selftest:doh": "node tools/selftest-doh.js",
    "selftest:autostart": "node tools/selftest-autostart.js",
    "selftest:settings-perf": "node tools/selftest-settings-perf.js",
    "selftest:permissions": "node tools/selftest-permissions.js",
    "selftest:catalog": "node tools/selftest-catalog.js",
    "selftest:custom-site": "node tools/selftest-custom-site.js",
    "selftest:edit-start-url": "node tools/selftest-edit-start-url.js",
    "check:ui-input-lag": "node tools/check-ui-input-lag.js",
    "selftest:notes": "node tools/selftest-notes.js",
    "selftest:reminders": "node tools/selftest-reminders.js",
    "selftest:sheet": "node tools/selftest-sheet.js",
    "selftest:volume": "node tools/selftest-volume.js",
    "check:volume-htzfm": "node tools/check-volume-htzfm.js",
    "selftest:layout-workspace": "node tools/selftest-layout-workspace.js",
    "selftest:layout-handles-startup": "node tools/selftest-layout-handles-startup.js",
    "selftest:popover-overlay": "node tools/selftest-popover-overlay.js",
    "selftest:popover-actions": "node tools/selftest-popover-actions.js",
    "selftest:languagetool": "node tools/selftest-languagetool.js",
    "selftest:ai": "node tools/selftest-ai.js",
    "selftest:badges": "node tools/selftest-badges.js",
    "check:realhover-volume": "node tools/realhover-volume.js",
    "shots:tools": "node tools/shots-tools.js",
    "shots:volume": "node tools/shots-volume.js",
    "check:update-live": "node tools/check-update-live.js",
    "check:adblock-real": "node tools/check-adblock-real.js",
    "check:encoding": "node tools/check-encoding.js",
    "check:lag-audit": "node tools/lag-audit.js",
    "check:sockets": "node tools/check-sockets.js",
    "check:perf": "node tools/check-perf.js",
    "check:security-review": "node tools/check-security.js",
    "check:release": "node tools/check-release.js",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-installer.ps1",
    "test:install-ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-install-ps1.ps1",
    "test:install-sh": "node tools/test-install-sh.js",
    "sha256sums": "node tools/sha256sums.js",
    "clean": "node tools/clean-dist.js",
    "predist": "npm run check:encoding && npm run clean",
    "predist:win": "npm run check:encoding && npm run clean",
    "predist:linux": "npm run check:encoding && npm run clean",
    "dist": "electron-builder --win --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postdist": "node tools/release.js",
    "postdist:win": "node tools/release.js",
    "postdist:linux": "node tools/release.js",
    "make-icon": "node tools/make-icon.js"
  },
  "build": {
    "appId": "com.leo.multiheiz",
    "productName": "MultiHeiz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/main/selftest-*.js",
      "!tools",
      "!tools/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/src/main/adblock/cosmetic-preload.js",
      "**/src/main/adblock/engine-worker.js",
      "**/src/preload/panel-preload.js",
      "**/src/main/extensions/sw-shim-preload.js",
      "**/src/main/extensions/early-preload.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "leoheiz",
        "repo": "MultiHeiz",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icons",
      "synopsis": "Navegador multi-janela com painéis e sessões independentes",
      "description": "Navegador multi-janela com painéis e sessões independentes",
      "maintainer": "Leo <leoheiz@users.noreply.github.com>",
      "executableName": "multiheiz",
      "syncDesktopName": true,
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "desktop": {
        "entry": {
          "Name": "MultiHeiz",
          "Comment": "Navegador multi-janela com painéis e sessões independentes",
          "Categories": "Network;WebBrowser;",
          "StartupWMClass": "multiheiz"
        }
      }
    },
    "appImage": {
      "artifactName": "MultiHeiz-${version}.${ext}"
    },
    "deb": {
      "packageCategory": "web",
      "maintainer": "Leo <leoheiz@users.noreply.github.com>",
      "artifactName": "multiheiz_${version}_amd64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiHeiz",
      "uninstallDisplayName": "${productName}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "include": "installer.nsh",
      "artifactName": "MultiHeiz-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "MultiHeiz-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@adguard/agtree": "^4.3.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
